<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 250 80" width="250" height="80">
  <!-- Fond du thème sombre -->
  <rect width="100%" height="100%" fill="#151515" rx="16"/>
  
  <!-- Icône (Carré arrondi bordeaux) -->
  <rect x="20" y="17.5" width="45" height="45" rx="12" fill="#a61e38"/>
  
  <!-- Texte dans l'icône -->
  <text x="42.5" y="47" font-family="Inter, Arial, sans-serif" font-weight="800" font-size="20" fill="#ffffff" text-anchor="middle">MS</text>
  
  <!-- Nom de l'entreprise -->
  <text x="80" y="49" font-family="Inter, Arial, sans-serif" font-weight="800" font-size="28" fill="#ffffff">
    MS<tspan fill="#a61e38">Corp</tspan>
  </text>
</svg>
